+    #[test]
+    fn current_pid_with_a_different_creation_identity_is_not_the_same_instance() {
+        let identity = current_process_identity().expect("current process identity");
+        let wrong = format!("{identity}-different");
+        assert!(
+            !is_process_instance_alive(std::process::id(), &wrong)
+                .expect("a creation-time mismatch is a negative match")
+        );
+    }
