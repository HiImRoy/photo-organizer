+    #[cfg(windows)]
+    #[test]
+    fn lease_blocks_external_write_rename_and_replacement_without_data_loss() {
+        let temporary = TempDir::new().expect("temporary directory");
+        let output = temporary.path().join("output");
+        fs::create_dir(&output).expect("output directory");
+        let target = output.join("generated.jpg");
+        let neighbor = output.join("neighbor.jpg");
+        let source_root = temporary.path().join("图库原图");
+        fs::create_dir(&source_root).expect("source root");
+        let source = source_root.join("original.jpg");
+        fs::write(&target, b"generated").expect("target");
+        fs::write(&neighbor, b"neighbor").expect("neighbor");
+        fs::write(&source, b"original").expect("source");
+        let mut lease = open_generated_target(&target, &[]).expect("lease");
+        let snapshot = lease.snapshot().expect("snapshot");
+
+        assert!(OpenOptions::new().write(true).open(&target).is_err());
+        let moved = output.join("moved.jpg");
+        assert!(fs::rename(&target, &moved).is_err());
+        assert!(fs::write(&target, b"replacement").is_err());
+
+        assert_eq!(fs::read(&target).expect("original remains"), b"generated");
+        assert!(!moved.exists());
+        assert_eq!(fs::read(&neighbor).expect("neighbor remains"), b"neighbor");
+
+        lease
+            .delete_checked(&snapshot.hash, &snapshot.file_identity)
+            .expect("same-handle deletion");
+        assert!(!target.exists());
+        assert_eq!(fs::read(neighbor).expect("neighbor remains"), b"neighbor");
+        assert_eq!(fs::read(source).expect("source remains"), b"original");
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn lease_deletes_its_handle_object_after_controlled_path_replacement() {
+        let temporary = TempDir::new().expect("temporary directory");
+        let output = temporary.path().join("output");
+        fs::create_dir(&output).expect("output directory");
+        let target = output.join("generated.jpg");
+        let moved_original = output.join("original-moved.jpg");
+        fs::write(&target, b"owned original").expect("target");
+
+        let lease = open_generated_target_with_share_mode(
+            &target,
+            &[],
+            FILE_SHARE_READ.0 | FILE_SHARE_WRITE.0 | FILE_SHARE_DELETE.0,
+        )
+        .expect("test lease permits a controlled external path change");
+        let mut lease = lease;
+        let snapshot = lease.snapshot().expect("original handle snapshot");
+        fs::rename(&target, &moved_original).expect("move original directory entry");
+        fs::write(&target, b"attacker replacement").expect("replacement path");
+
+        lease
+            .delete_checked(&snapshot.hash, &snapshot.file_identity)
+            .expect("delete the object still held by the lease");
+        assert_eq!(
+            fs::read(&target).expect("replacement must remain"),
+            b"attacker replacement"
+        );
+        assert!(!moved_original.exists());
+    }
