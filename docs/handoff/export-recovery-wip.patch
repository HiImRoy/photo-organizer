@@ -0,0 +1,798 @@
+//! Handle-bound checks for generated export files.
+//!
+//! Windows operations keep a file handle open while hashing, checking its
+//! physical identity and resolved path, and (for deletion) marking that same
+//! handle's object for deletion. No image decoder is used here.
+
+#[cfg(any(windows, test))]
+use std::fs;
+use std::fs::File;
+#[cfg(windows)]
+use std::fs::OpenOptions;
+#[cfg(windows)]
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::path::{Path, PathBuf};
+
+use crate::error::{AppError, AppResult};
+#[cfg(any(windows, test))]
+use crate::source_identity::identity_key;
+#[cfg(windows)]
+use crate::source_identity::{is_same_or_descendant, normalize_path_string};
+
+#[cfg(windows)]
+use std::os::windows::io::AsRawHandle;
+
+#[cfg(windows)]
+use std::os::windows::fs::OpenOptionsExt;
+
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+
+#[cfg(windows)]
+use windows::Win32::Foundation::{FILETIME, GENERIC_READ, GENERIC_WRITE, GetLastError, HANDLE};
+#[cfg(windows)]
+use windows::Win32::Storage::FileSystem::{
+    BY_HANDLE_FILE_INFORMATION, DELETE, FILE_DISPOSITION_INFO, FILE_SHARE_DELETE,
+    FILE_SHARE_READ, FILE_SHARE_WRITE, FileDispositionInfo, GetFileInformationByHandle,
+    GetFinalPathNameByHandleW, SetFileInformationByHandle, VOLUME_NAME_DOS,
+};
+#[cfg(windows)]
+use windows::Win32::System::Threading::{
+    GetCurrentProcess, GetExitCodeProcess, GetProcessTimes, OpenProcess,
+    PROCESS_QUERY_LIMITED_INFORMATION,
+};
+
+#[cfg(windows)]
+const HASH_BUFFER_SIZE: usize = 64 * 1024;
+
+/// The bytes, physical file, and resolved path observed through one handle.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TargetSnapshot {
+    pub hash: String,
+    pub file_identity: String,
+    pub final_path: PathBuf,
+}
+
+/// A generated file held open with restrictive sharing until finalized or
+/// safely aborted.
+#[derive(Debug)]
+pub struct GeneratedTargetWriter {
+    file: File,
+    protected_roots: Vec<String>,
+    created_identity: String,
+    created_path: PathBuf,
+}
+
+/// A generated target held open while it is inspected and optionally deleted.
+#[derive(Debug)]
+pub struct GeneratedTargetLease {
+    file: File,
+    protected_roots: Vec<String>,
+}
+
+/// Read only filesystem identity metadata for an existing file.
+///
+/// This function never decodes image data or reads file contents.
+pub fn inspect_file_identity(path: &Path) -> AppResult<String> {
+    #[cfg(windows)]
+    {
+        let mut options = OpenOptions::new();
+        options
+            .read(true)
+            .share_mode(FILE_SHARE_READ.0 | FILE_SHARE_WRITE.0 | FILE_SHARE_DELETE.0);
+        let file = options.open(path)?;
+        return file_identity(&file);
+    }
+
+    #[cfg(unix)]
+    {
+        let file = File::open(path)?;
+        let metadata = file.metadata()?;
+        return Ok(format!("unix:dev:{:x}:ino:{:x}", metadata.dev(), metadata.ino()));
+    }
+
+    #[cfg(not(any(windows, unix)))]
+    {
+        let _ = path;
+        Err(unsupported("file identity is unavailable on this platform"))
+    }
+}
+
+/// Open an existing generated target while denying other handles write and
+/// delete access. All snapshot checks and deletion use this same handle.
+pub fn open_generated_target(
+    path: &Path,
+    protected_roots: &[String],
+) -> AppResult<GeneratedTargetLease> {
+    #[cfg(windows)]
+    {
+        open_generated_target_with_share_mode(path, protected_roots, FILE_SHARE_READ.0)
+    }
+
+    #[cfg(not(windows))]
+    {
+        let _ = (path, protected_roots);
+        Err(unsupported(
+            "handle-bound generated-target leases require Windows file disposition support",
+        ))
+    }
+}
+
+impl GeneratedTargetLease {
+    /// Snapshot the hash, physical identity, and final path of the held object.
+    pub fn snapshot(&mut self) -> AppResult<TargetSnapshot> {
+        #[cfg(windows)]
+        {
+            snapshot_handle(&mut self.file, &self.protected_roots)
+        }
+
+        #[cfg(not(windows))]
+        {
+            Err(unsupported(
+                "handle-bound generated-target snapshots require Windows",
+            ))
+        }
+    }
+
+    /// Delete the object held by this lease only if all expected values still
+    /// match. Windows marks the file represented by this exact handle for
+    /// deletion; the path is never reopened or re-resolved for deletion.
+    pub fn delete_checked(
+        mut self,
+        expected_hash: &str,
+        expected_identity: &str,
+    ) -> AppResult<()> {
+        #[cfg(windows)]
+        {
+            let snapshot = snapshot_handle(&mut self.file, &self.protected_roots)?;
+            if snapshot.hash != expected_hash {
+                return Err(AppError::InvalidArgument(
+                    "generated target hash changed before handle-bound deletion".into(),
+                ));
+            }
+            if snapshot.file_identity != expected_identity {
+                return Err(AppError::InvalidArgument(
+                    "generated target file identity changed before handle-bound deletion".into(),
+                ));
+            }
+            mark_handle_for_deletion(&self.file)?;
+            return Ok(());
+        }
+
+        #[cfg(not(windows))]
+        {
+            let _ = (expected_hash, expected_identity);
+            Err(unsupported(
+                "safe deletion by the verified file handle is unavailable on this platform",
+            ))
+        }
+    }
+}
+
+/// Create a new generated target without ever replacing an existing entry.
+/// The returned writer owns the file handle used for identity checks,
+/// finalization, and any abort cleanup.
+pub fn create_generated_target(
+    path: &Path,
+    protected_roots: &[String],
+) -> AppResult<GeneratedTargetWriter> {
+    #[cfg(windows)]
+    {
+        validate_new_target_path(path, protected_roots)?;
+
+        let mut options = OpenOptions::new();
+        options
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .access_mode(GENERIC_READ.0 | GENERIC_WRITE.0 | DELETE.0)
+            .share_mode(FILE_SHARE_READ.0);
+        let file = options.open(path)?;
+
+        let validation: AppResult<(PathBuf, String)> = (|| {
+            let final_path = final_path_by_handle(&file)?;
+            ensure_outside_protected_roots(&final_path, protected_roots)?;
+            let created_identity = file_identity(&file)?;
+            Ok((final_path, created_identity))
+        })();
+
+        match validation {
+            Ok((created_path, created_identity)) => Ok(GeneratedTargetWriter {
+                file,
+                protected_roots: protected_roots.to_vec(),
+                created_identity,
+                created_path,
+            }),
+            Err(error) => Err(cleanup_failed_creation(file, protected_roots, error)),
+        }
+    }
+
+    #[cfg(not(windows))]
+    {
+        let _ = (path, protected_roots);
+        Err(unsupported(
+            "safe generated-target creation requires handle-bound Windows cleanup",
+        ))
+    }
+}
+
+impl GeneratedTargetWriter {
+    /// The image encoder writes only to this newly created, application-owned
+    /// destination. This API does not open or decode source image files.
+    pub fn file_mut(&mut self) -> &mut File {
+        &mut self.file
+    }
+
+    /// Return the identity of the file created by this writer. Call before
+    /// recording that identity in the export operation log.
+    pub fn file_identity(&self) -> AppResult<String> {
+        let identity = file_identity(&self.file)?;
+        if identity != self.created_identity {
+            return Err(AppError::InvalidArgument(
+                "generated target identity no longer matches its creation handle".into(),
+            ));
+        }
+        Ok(identity)
+    }
+
+    /// Flush and sync the generated file, then return a final snapshot taken
+    /// through the still-open creation handle.
+    pub fn finish(mut self) -> AppResult<TargetSnapshot> {
+        #[cfg(windows)]
+        {
+            self.file.flush()?;
+            self.file.sync_all()?;
+            let snapshot = snapshot_handle(&mut self.file, &self.protected_roots)?;
+            if snapshot.file_identity != self.created_identity {
+                return Err(AppError::InvalidArgument(
+                    "generated target identity changed before finalization".into(),
+                ));
+            }
+            Ok(snapshot)
+        }
+
+        #[cfg(not(windows))]
+        {
+            Err(unsupported(
+                "safe generated-target finalization is unavailable on this platform",
+            ))
+        }
+    }
+
+    /// Safely remove only the file object created by this writer. If the
+    /// platform or filesystem cannot do that through the held handle, the
+    /// operation fails and leaves the file in place.
+    pub fn abort(self) -> AppResult<()> {
+        #[cfg(windows)]
+        {
+            let current_path = final_path_by_handle(&self.file)?;
+            ensure_outside_protected_roots(&current_path, &self.protected_roots)?;
+            if file_identity(&self.file)? != self.created_identity {
+                return Err(AppError::InvalidArgument(
+                    "generated target identity changed before abort".into(),
+                ));
+            }
+            match mark_handle_for_deletion(&self.file) {
+                Ok(()) => Ok(()),
+                Err(error) => Err(AppError::InvalidArgument(format!(
+                    "could not safely remove generated target {}; the file may remain: {error}",
+                    self.created_path.display()
+                ))),
+            }
+        }
+
+        #[cfg(not(windows))]
+        {
+            Err(unsupported(
+                "safe abort by the creation handle is unavailable on this platform",
+            ))
+        }
+    }
+}
+
+/// Identify the current process instance. On Windows the value is the process
+/// creation FILETIME, which distinguishes PID reuse.
+pub fn current_process_identity() -> AppResult<String> {
+    #[cfg(windows)]
+    {
+        let mut creation = FILETIME::default();
+        let mut exit = FILETIME::default();
+        let mut kernel = FILETIME::default();
+        let mut user = FILETIME::default();
+        unsafe {
+            GetProcessTimes(
+                GetCurrentProcess(),
+                &mut creation,
+                &mut exit,
+                &mut kernel,
+                &mut user,
+            )
+            .map_err(windows_error)?;
+        }
+        return Ok(process_creation_identity(&creation));
+    }
+
+    #[cfg(not(windows))]
+    {
+        static PROCESS_STAMP: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+        Ok(PROCESS_STAMP
+            .get_or_init(|| format!("local:{}", uuid::Uuid::new_v4()))
+            .clone())
+    }
+}
+
+/// Check a process instance, not merely whether its numeric PID currently
+/// exists. Unknown access or platform state is returned as an error.
+pub fn is_process_instance_alive(pid: u32, creation_identity: &str) -> AppResult<bool> {
+    #[cfg(windows)]
+    {
+        let process = match unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) } {
+            Ok(process) => process,
+            Err(error) if is_process_not_found_error(&error) => return Ok(false),
+            Err(error) => return Err(windows_error(error)),
+        };
+
+        let mut exit_code = 0_u32;
+        let mut creation = FILETIME::default();
+        let mut exit = FILETIME::default();
+        let mut kernel = FILETIME::default();
+        let mut user = FILETIME::default();
+        let process_result = unsafe {
+            GetExitCodeProcess(process, &mut exit_code).and_then(|()| {
+                GetProcessTimes(
+                    process,
+                    &mut creation,
+                    &mut exit,
+                    &mut kernel,
+                    &mut user,
+                )
+            })
+        };
+        unsafe {
+            let _ = windows::Win32::Foundation::CloseHandle(process);
+        }
+        process_result.map_err(windows_error)?;
+
+        if exit_code != windows::Win32::Foundation::STILL_ACTIVE.0 as u32 {
+            return Ok(false);
+        }
+        return Ok(process_creation_identity(&creation) == creation_identity);
+    }
+
+    #[cfg(not(windows))]
+    {
+        if pid != std::process::id() {
+            return Err(unsupported(
+                "this platform cannot verify another process instance",
+            ));
+        }
+        Ok(current_process_identity()? == creation_identity)
+    }
+}
+
+#[cfg(windows)]
+fn open_generated_target_with_share_mode(
+    path: &Path,
+    protected_roots: &[String],
+    share_mode: u32,
+) -> AppResult<GeneratedTargetLease> {
+    let mut options = OpenOptions::new();
+    options
+        .read(true)
+        .access_mode(GENERIC_READ.0 | DELETE.0)
+        .share_mode(share_mode);
+    let file = options.open(path)?;
+    let final_path = final_path_by_handle(&file)?;
+    ensure_outside_protected_roots(&final_path, protected_roots)?;
+    Ok(GeneratedTargetLease {
+        file,
+        protected_roots: protected_roots.to_vec(),
+    })
+}
+
+#[cfg(windows)]
+fn snapshot_handle(file: &mut File, protected_roots: &[String]) -> AppResult<TargetSnapshot> {
+    let final_path = final_path_by_handle(file)?;
+    ensure_outside_protected_roots(&final_path, protected_roots)?;
+    let file_identity = file_identity(file)?;
+    let hash = hash_file_handle(file)?;
+    Ok(TargetSnapshot {
+        hash,
+        file_identity,
+        final_path,
+    })
+}
+
+#[cfg(windows)]
+fn hash_file_handle(file: &mut File) -> AppResult<String> {
+    file.seek(SeekFrom::Start(0))?;
+    let mut hasher = blake3::Hasher::new();
+    let mut buffer = [0_u8; HASH_BUFFER_SIZE];
+    loop {
+        let bytes = file.read(&mut buffer)?;
+        if bytes == 0 {
+            break;
+        }
+        hasher.update(&buffer[..bytes]);
+    }
+    Ok(hasher.finalize().to_hex().to_string())
+}
+
+#[cfg(windows)]
+fn file_identity(file: &File) -> AppResult<String> {
+    let handle = HANDLE(file.as_raw_handle() as _);
+    let mut info = BY_HANDLE_FILE_INFORMATION::default();
+    unsafe {
+        GetFileInformationByHandle(handle, &mut info).map_err(windows_error)?;
+    }
+
+    let file_index = (u64::from(info.nFileIndexHigh) << 32) | u64::from(info.nFileIndexLow);
+    let creation_time = filetime_ticks(&info.ftCreationTime);
+    if info.dwVolumeSerialNumber == 0 || file_index == 0 || creation_time == 0 {
+        return Err(unsupported(
+            "the filesystem did not provide a complete physical file identity",
+        ));
+    }
+    Ok(format!(
+        "win:volume:{:08x}:file:{file_index:016x}:created:{creation_time:016x}",
+        info.dwVolumeSerialNumber
+    ))
+}
+
+#[cfg(not(windows))]
+fn file_identity(_file: &File) -> AppResult<String> {
+    Err(unsupported(
+        "handle-based file identity is unavailable on this platform",
+    ))
+}
+
+#[cfg(windows)]
+fn final_path_by_handle(file: &File) -> AppResult<PathBuf> {
+    let handle = HANDLE(file.as_raw_handle() as _);
+    let mut buffer = vec![0_u16; 512];
+    loop {
+        let length = unsafe { GetFinalPathNameByHandleW(handle, &mut buffer, VOLUME_NAME_DOS) };
+        if length == 0 {
+            return Err(last_windows_io_error());
+        }
+        let length = length as usize;
+        if length < buffer.len() {
+            use std::os::windows::ffi::OsStringExt;
+            return Ok(PathBuf::from(std::ffi::OsString::from_wide(
+                &buffer[..length],
+            )));
+        }
+        if length >= 32_768 {
+            return Err(unsupported(
+                "the resolved Windows path exceeds the supported length",
+            ));
+        }
+        buffer.resize(length + 1, 0);
+    }
+}
+
+#[cfg(windows)]
+fn mark_handle_for_deletion(file: &File) -> AppResult<()> {
+    let handle = HANDLE(file.as_raw_handle() as _);
+    let disposition = FILE_DISPOSITION_INFO { DeleteFile: true };
+    unsafe {
+        SetFileInformationByHandle(
+            handle,
+            FileDispositionInfo,
+            (&disposition as *const FILE_DISPOSITION_INFO).cast(),
+            std::mem::size_of::<FILE_DISPOSITION_INFO>() as u32,
+        )
+        .map_err(windows_error)?;
+    }
+    Ok(())
+}
+
+#[cfg(windows)]
+fn filetime_ticks(filetime: &FILETIME) -> u64 {
+    (u64::from(filetime.dwHighDateTime) << 32) | u64::from(filetime.dwLowDateTime)
+}
+
+#[cfg(windows)]
+fn process_creation_identity(creation: &FILETIME) -> String {
+    format!("{:016x}", filetime_ticks(creation))
+}
+
+#[cfg(windows)]
+fn windows_error(error: windows::core::Error) -> AppError {
+    AppError::Io(std::io::Error::other(error))
+}
+
+#[cfg(windows)]
+fn last_windows_io_error() -> AppError {
+    let code = unsafe { GetLastError() };
+    AppError::Io(std::io::Error::from_raw_os_error(code.0 as i32))
+}
+
+#[cfg(windows)]
+fn is_process_not_found_error(error: &windows::core::Error) -> bool {
+    let code = error.code().0 as u32;
+    code == hresult_from_win32(windows::Win32::Foundation::ERROR_INVALID_PARAMETER.0)
+        || code == hresult_from_win32(windows::Win32::Foundation::ERROR_NOT_FOUND.0)
+}
+
+#[cfg(windows)]
+fn hresult_from_win32(error: u32) -> u32 {
+    if error == 0 {
+        0
+    } else {
+        (error & 0x0000_ffff) | 0x8007_0000
+    }
+}
+
+#[cfg(windows)]
+fn validate_new_target_path(path: &Path, protected_roots: &[String]) -> AppResult<()> {
+    let file_name = path.file_name().ok_or_else(|| {
+        AppError::InvalidArgument("generated target path must name a file".into())
+    })?;
+    let parent = path
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+        .unwrap_or_else(|| Path::new("."));
+    let final_parent = fs::canonicalize(parent)?;
+    let candidate = final_parent.join(file_name);
+    ensure_outside_protected_roots(&candidate, protected_roots)
+}
+
+#[cfg(windows)]
+fn ensure_outside_protected_roots(path: &Path, protected_roots: &[String]) -> AppResult<()> {
+    let target_identity = identity_key(path);
+    if protected_roots.iter().any(|root| {
+        let root_identity = normalize_path_string(root);
+        is_same_or_descendant(&root_identity, &target_identity)
+    }) {
+        return Err(AppError::UnsafePath(path.to_path_buf()));
+    }
+    Ok(())
+}
+
+#[cfg(windows)]
+fn cleanup_failed_creation(
+    file: File,
+    protected_roots: &[String],
+    original_error: AppError,
+) -> AppError {
+    let cleanup = final_path_by_handle(&file)
+        .and_then(|path| ensure_outside_protected_roots(&path, protected_roots))
+        .and_then(|()| mark_handle_for_deletion(&file));
+    drop(file);
+    match cleanup {
+        Ok(()) => original_error,
+        Err(cleanup_error) => AppError::InvalidArgument(format!(
+            "generated target creation failed ({original_error}); its file could not be safely removed and may remain ({cleanup_error})"
+        )),
+    }
+}
+
+fn unsupported(message: &str) -> AppError {
+    AppError::Io(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        message.to_owned(),
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tempfile::TempDir;
+
+    fn roots(paths: &[&Path]) -> Vec<String> {
+        paths
+            .iter()
+            .map(|path| identity_key(path))
+            .collect()
+    }
+
+    #[test]
+    fn file_identity_reads_metadata_without_decoding_file_contents() {
+        let temporary = TempDir::new().expect("temporary directory");
+        let path = temporary.path().join("高分辨率-源图像.jpg");
+        fs::write(&path, vec![0x5a; 4 * 1024 * 1024]).expect("write test-owned bytes");
+
+        let identity = inspect_file_identity(&path).expect("metadata identity");
+        assert!(!identity.is_empty());
+    }
