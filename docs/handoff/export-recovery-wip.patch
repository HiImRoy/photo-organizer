+    #[cfg(windows)]
+    #[test]
+    fn generated_targets_reject_protected_roots_and_support_unicode_paths() {
+        let temporary = TempDir::new().expect("temporary directory");
+        let protected = temporary.path().join("图库原图");
+        fs::create_dir(&protected).expect("protected root");
+        let protected_target = protected.join("must-not-exist.jpg");
+        let protected_roots = roots(&[&protected]);
+        let error = create_generated_target(&protected_target, &protected_roots)
+            .expect_err("protected root must be rejected");
+        assert!(matches!(error, AppError::UnsafePath(_)));
+        assert!(!protected_target.exists());
+
+        let output = temporary.path().join("экспорт 旅行 café");
+        fs::create_dir(&output).expect("output directory");
+        let target = output.join("雪だるま-照片.jpg");
+        let mut writer = create_generated_target(&target, &protected_roots)
+            .expect("unicode target creation");
+        let identity = writer.file_identity().expect("pre-write identity");
+        writer.file_mut().write_all(b"generated output").expect("write");
+        let snapshot = writer.finish().expect("finish");
+        assert_eq!(snapshot.file_identity, identity);
+        assert_eq!(
+            identity_key(&snapshot.final_path),
+            identity_key(&fs::canonicalize(&target).expect("canonical path"))
+        );
+    }
