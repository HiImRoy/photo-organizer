+    fn edit_export_audit_migration_failure_rolls_back_schema_and_data() {
+        let temp = tempfile::tempdir().expect("temp dir");
+        let repository = Repository::new(temp.path().join("legacy.sqlite3"));
+        initialize_legacy_schema_at_version_17(&repository);
+        {
+            let connection = repository.open().expect("legacy fixture connection");
+            seed_legacy_edit_export_audit_fixture(&connection);
+            connection
+                .execute_batch(
+                    "CREATE TRIGGER reject_version_18_marker
+                     BEFORE INSERT ON schema_migrations
+                     WHEN NEW.version=18
+                     BEGIN
+                         SELECT RAISE(ABORT, 'forced migration marker failure');
+                     END;",
+                )
+                .expect("install migration failure trigger");
+        }
+
+        assert!(repository.initialize().is_err());
+        assert_eq!(
+            repository
+                .migration_version()
+                .expect("version after failure"),
+            17
+        );
+        let connection = repository.open().expect("database after failed migration");
+        for (table, column) in [
+            ("edit_export_plans", "source_path"),
+            ("file_operations", "target_file_identity"),
+            ("file_operations", "execution_owner_pid"),
+            ("file_operations", "execution_owner_started_at"),
+            ("file_operations", "rollback_owner_pid"),
+            ("file_operations", "rollback_owner_started_at"),
+        ] {
+            let count: i64 = connection
+                .query_row(
+                    "SELECT COUNT(*) FROM pragma_table_info(?1) WHERE name=?2",
+                    params![table, column],
+                    |row| row.get(0),
+                )
+                .expect("column rollback lookup");
+            assert_eq!(count, 0, "partial column remained: {table}.{column}");
+        }
+        let old_plan_count: i64 = connection
+            .query_row("SELECT COUNT(*) FROM edit_export_plans", [], |row| {
+                row.get(0)
+            })
+            .expect("old plans survive failed migration");
+        assert_eq!(old_plan_count, 2);
+        connection
+            .execute_batch("DROP TRIGGER reject_version_18_marker")
+            .expect("remove migration failure trigger");
+        drop(connection);
+
+        repository.initialize().expect("migration retry succeeds");
+        assert_eq!(repository.migration_version().expect("retry version"), 18);
+        let connection = repository.open().expect("database after migration retry");
+        let plan_count: i64 = connection
+            .query_row("SELECT COUNT(*) FROM edit_export_plans", [], |row| {
+                row.get(0)
+            })
+            .expect("all plans preserved on retry");
+        assert_eq!(plan_count, 2);
+    }
