+fn migrate_edit_export_audit_recovery(transaction: &Transaction<'_>) -> AppResult<()> {
+    let library_roots = {
+        let mut statement = transaction.prepare(
+            "SELECT source_identity_key, source_path, root_path
+             FROM libraries ORDER BY id",
+        )?;
+        statement
+            .query_map([], |row| {
+                Ok((
+                    row.get::<_, String>(0)?,
+                    row.get::<_, String>(1)?,
+                    row.get::<_, String>(2)?,
+                ))
+            })?
+            .collect::<Result<Vec<_>, _>>()?
+    };
+    let mut protected_roots = library_roots
+        .into_iter()
+        .filter_map(|(stored_identity, source_path, root_path)| {
+            let identity = if !stored_identity.is_empty() {
+                stored_identity
+            } else {
+                let fallback_path = if !source_path.is_empty() {
+                    source_path
+                } else {
+                    root_path
+                };
+                identity_key(Path::new(&fallback_path))
+            };
+            (!identity.is_empty()).then_some(identity)
+        })
+        .collect::<Vec<_>>();
+    protected_roots.sort();
+    protected_roots.dedup();
+    let protected_roots_json = serde_json::to_string(&protected_roots)?;
+    transaction.execute(
+        "UPDATE edit_export_plans SET protected_roots_json=?1",
+        [protected_roots_json],
+    )?;
+    Ok(())
+}
