+const PREVIEW_AUTHORIZATION_TTL: Duration = Duration::from_secs(5 * 60);
+const PREVIEW_AUTHORIZATION_CAPACITY: usize = 64;
+const DEFAULT_EDIT_EXPORT_HISTORY_PAGE_SIZE: u32 = 200;
+const MAX_EDIT_EXPORT_HISTORY_PAGE_SIZE: u32 = 500;
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct EditRollbackPreviewResponse {
+    #[serde(flatten)]
+    pub snapshot: EditRollbackPlan,
+    pub confirmation_token: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct EditRecoveryPreviewResponse {
+    #[serde(flatten)]
+    pub snapshot: EditRecoveryPlan,
+    pub confirmation_token: String,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum PreviewAuthorizationOperation {
+    Rollback,
+    Recovery,
+}
+
+#[derive(Debug)]
+enum PreviewAuthorizationSnapshot {
+    Rollback(EditRollbackPlan),
+    Recovery(EditRecoveryPlan),
+}
+
+impl PreviewAuthorizationSnapshot {
+    fn plan_id(&self) -> &str {
+        match self {
+            Self::Rollback(snapshot) => &snapshot.plan_id,
+            Self::Recovery(snapshot) => &snapshot.plan_id,
+        }
+    }
+
+    fn operation(&self) -> PreviewAuthorizationOperation {
+        match self {
+            Self::Rollback(_) => PreviewAuthorizationOperation::Rollback,
+            Self::Recovery(_) => PreviewAuthorizationOperation::Recovery,
+        }
+    }
+}
+
+#[derive(Debug)]
+struct PreviewAuthorization {
+    token: String,
+    database_identity: PathBuf,
+    operation: PreviewAuthorizationOperation,
+    plan_id: String,
+    snapshot: PreviewAuthorizationSnapshot,
+    created_at: Instant,
+}
+
+#[derive(Debug, Default)]
+struct PreviewAuthorizationStore {
+    authorizations: std::collections::VecDeque<PreviewAuthorization>,
+}
+
+impl PreviewAuthorizationStore {
+    fn issue(
+        &mut self,
+        database_identity: PathBuf,
+        snapshot: PreviewAuthorizationSnapshot,
+        now: Instant,
+    ) -> String {
+        let operation = snapshot.operation();
+        let plan_id = snapshot.plan_id().to_owned();
+        self.authorizations.retain(|authorization| {
+            now.saturating_duration_since(authorization.created_at) < PREVIEW_AUTHORIZATION_TTL
+                && !(authorization.database_identity == database_identity
+                    && authorization.operation == operation
+                    && authorization.plan_id == plan_id)
+        });
+
+        while self.authorizations.len() >= PREVIEW_AUTHORIZATION_CAPACITY {
+            self.authorizations.pop_front();
+        }
+
+        let token = Uuid::new_v4().to_string();
+        self.authorizations.push_back(PreviewAuthorization {
+            token: token.clone(),
+            database_identity,
+            operation,
+            plan_id,
+            snapshot,
+            created_at: now,
+        });
+        token
+    }
+
+    fn take(
+        &mut self,
+        token: &str,
+        requested_database_identity: &Path,
+        requested_operation: PreviewAuthorizationOperation,
+        requested_plan_id: &str,
+        now: Instant,
+    ) -> Result<PreviewAuthorizationSnapshot, String> {
+        let Some(index) = self
+            .authorizations
+            .iter()
+            .position(|authorization| authorization.token == token)
+        else {
+            return Err(
+                "confirmation token is unknown, expired, or has already been used".into(),
+            );
+        };
+        let authorization = self
+            .authorizations
+            .remove(index)
+            .expect("authorization index was found");
+
+        if now.saturating_duration_since(authorization.created_at) >= PREVIEW_AUTHORIZATION_TTL {
+            return Err("confirmation token has expired; preview again".into());
+        }
+        if authorization.database_identity != requested_database_identity {
+            return Err("confirmation token belongs to a different database".into());
+        }
+        if authorization.operation != requested_operation
+            || authorization.snapshot.operation() != requested_operation
+        {
+            return Err("confirmation token is for a different operation".into());
+        }
+        if authorization.plan_id != requested_plan_id
+            || authorization.snapshot.plan_id() != requested_plan_id
+        {
+            return Err("confirmation token is for a different plan".into());
+        }
+        Ok(authorization.snapshot)
+    }
+}
