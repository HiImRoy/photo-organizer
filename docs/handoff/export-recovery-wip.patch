+    #[test]
+    fn current_process_identity_is_stable_and_matches_current_instance() {
+        let first = current_process_identity().expect("current process identity");
+        let second = current_process_identity().expect("stable process identity");
+        assert_eq!(first, second);
+        assert!(
+            is_process_instance_alive(std::process::id(), &first)
+                .expect("current process should be verifiable")
+        );
+    }
