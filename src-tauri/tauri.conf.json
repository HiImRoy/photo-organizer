{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoOrganizer",
  "version": "0.1.0",
  "identifier": "com.photoorganizer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoOrganizer",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dataDirectory": "webview-dev",
        "backgroundColor": "#1C2026"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/models/**/*", "resources/runtime/**/*"],
    "targets": ["msi", "nsis"],
    "category": "Photography",
    "shortDescription": "Local-first photo library",
    "longDescription": "Scan, preview, analyze, and safely plan photo organization without modifying originals.",
    "copyright": "Copyright © 2026 PhotoOrganizer contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
